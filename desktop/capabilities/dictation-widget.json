{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dictation-widget",
  "description": "Pływające okno dyktowania: tylko komunikacja z lokalnym silnikiem, bez aktualizacji i restartu aplikacji.",
  "windows": [
    "dictation-widget"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
