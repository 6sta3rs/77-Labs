{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Prywatny silnik Seventy Seven Labs na interfejsie loopback, zarządzany przez aplikację desktopową.",
  "windows": [
    "main",
    "dictation-widget"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:4312/*"
        }
      ]
    }
  ]
}
