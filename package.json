{
  "name": "seventy-seven-labs",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:buttons": "node tests/frontend/button-system-check.mjs",
    "test:styles": "node tests/frontend/ui-colors-check.mjs && node tests/frontend/focus-intent-check.mjs && node tests/frontend/ui-overlay-check.mjs",
    "test:ui": "node scripts/dev/run-checks.mjs",
    "qa:ui": "node scripts/preview/ui-performance-preview.mjs",
    "qa:editor": "node scripts/preview/editor-performance-preview.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4310 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:release": "node scripts/release/build-update.mjs",
    "test:structure": "node scripts/dev/check-structure.mjs",
    "i18n:status": "node scripts/dev/i18n-lang.mjs status",
    "i18n:missing": "node scripts/dev/i18n-lang.mjs missing",
    "i18n:add": "node scripts/dev/i18n-lang.mjs add"
  },
  "dependencies": {
    "@lucide/svelte": "1.59.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.20.5",
    "postcss": "8.5.31",
    "svelte-check": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "license": "AGPL-3.0-only",
  "description": "A local voice studio for Windows: narration, speech synthesis, and transcription."
}
