{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seventy Seven Labs",
  "mainBinaryName": "seventy-seven-labs",
  "version": "0.2.2",
  "identifier": "local.studioa1tts.voicestudio-next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4310",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Seventy Seven Labs", "width": 1440, "height": 940, "minWidth": 800, "minHeight": 650, "backgroundColor": "#101011" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:4312 ws://127.0.0.1:4312" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "createUpdaterArtifacts": true, "icon": ["icons/icon.ico"] },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODFGMzRGMDc1NUM5NUQKUldSZHlWVUhUL09CbSs2alhCTCtLVExCUGJtTHhrVE1Ub201a1ZnVDUydGFaWDBDbjRIZzZPbEcK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}
